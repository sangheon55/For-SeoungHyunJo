{
  "name": "seonghyeon-planner",
  "productName": "Seonghyeon Planner",
  "version": "1.2.0",
  "private": true,
  "description": "조성현을 위한 5급 기술고시 합격 플래너",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "app": "vite build && electron .",
    "dist": "vite build && electron-packager . \"Seonghyeon Planner\" --platform=win32 --arch=x64 --out=release --overwrite --icon=electron/icon.ico --ignore=release --ignore=src --ignore=\".md$\""
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@electron/packager": "^20.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "vite": "^6.0.7"
  },
  "build": {
    "appId": "com.seonghyeon.planner",
    "productName": "조성현 합격 플래너",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": "portable",
      "icon": "electron/icon.ico"
    }
  }
}
