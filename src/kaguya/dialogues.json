{
  "version": 1,
  "lines": [
    {
      "id": "timer-idle-01",
      "key": "timer.idle",
      "char": "kaguya",
      "face": "neutral",
      "text": "오늘 계획은 확인하셨나요, 성현 씨?",
      "inner": "(왔네. 기다렸다는 티는 내지 말아야지.)"
    },
    {
      "id": "timer-idle-02",
      "key": "timer.idle",
      "char": "kaguya",
      "face": "smug",
      "text": "설마 타이머만 바라보다 돌아가실 생각은 아니시겠죠?",
      "inner": "(빨리 시작하면 좋을 텐데.)"
    },
    {
      "id": "timer-start-morning-01",
      "key": "timer.start.morning",
      "char": "kaguya",
      "face": "neutral",
      "text": "아침부터 {subject}인가요. 제법 성실하시네요.",
      "inner": "(나보다 먼저 시작한 건 조금 분하지만.)"
    },
    {
      "id": "timer-start-morning-02",
      "key": "timer.start.morning",
      "char": "kaguya",
      "face": "smile",
      "text": "좋은 아침이에요. {subject}부터 차분히 시작하시죠.",
      "inner": "(첫마디를 내가 먼저 해 버렸네.)"
    },
    {
      "id": "timer-start-day-01",
      "key": "timer.start.day",
      "char": "kaguya",
      "face": "neutral",
      "text": "{subject}를 시작하시는군요. 방해하지 않고 지켜볼게요.",
      "inner": "(끝날 때까지 여기 있을 거라는 뜻은 아니니까.)"
    },
    {
      "id": "timer-start-day-02",
      "key": "timer.start.day",
      "char": "kaguya",
      "face": "smug",
      "text": "준비는 끝나셨겠죠? {subject}, 시작해 보세요.",
      "inner": "(오늘은 얼마나 집중할지 기대돼.)"
    },
    {
      "id": "timer-start-night-01",
      "key": "timer.start.night",
      "char": "kaguya",
      "face": "neutral",
      "text": "늦은 시간이네요. {subject}는 깔끔하게 끝내고 쉬세요.",
      "inner": "(무리하면 내가 신경 쓰이잖아.)"
    },
    {
      "id": "timer-start-night-02",
      "key": "timer.start.night",
      "char": "kaguya",
      "face": "smile",
      "text": "밤까지 공부라니, 상당히 진지하시군요.",
      "inner": "(조금만 더 같이 있어도 되겠네.)"
    },
    {
      "id": "timer-end-short-01",
      "key": "timer.end.short",
      "char": "kaguya",
      "face": "smug",
      "text": "이제 막 시작한 줄 알았는데, 벌써 끝이신가요?",
      "inner": "(그래도 앉은 게 어디야. 다음에는 조금 더 오래 있을까.)"
    },
    {
      "id": "timer-end-short-02",
      "key": "timer.end.short",
      "char": "kaguya",
      "face": "neutral",
      "text": "{duration}. 짧지만 기록은 기록이네요.",
      "inner": "(아예 하지 않은 것보다는 훨씬 나아.)"
    },
    {
      "id": "timer-end-normal-01",
      "key": "timer.end.normal",
      "char": "kaguya",
      "face": "smile",
      "text": "{duration} 동안 집중하셨네요. 나쁘지 않았어요, 성현 씨.",
      "inner": "(사실은 꽤 대단했다고 생각하지만.)"
    },
    {
      "id": "timer-end-normal-02",
      "key": "timer.end.normal",
      "char": "kaguya",
      "face": "neutral",
      "text": "{subject} 공부를 {duration}. 오늘 몫은 분명히 쌓였어요.",
      "inner": "(꾸준히 하는 모습을 보면 안심돼.)"
    },
    {
      "id": "timer-end-impressive-01",
      "key": "timer.end.impressive",
      "char": "kaguya",
      "face": "smug",
      "text": "제법이네요.",
      "inner": "(두 시간 이상 집중하다니… 솔직히 감탄했어.)"
    },
    {
      "id": "timer-end-long-01",
      "key": "timer.end.long",
      "char": "kaguya",
      "face": "smile",
      "text": "네 시간이나 하셨군요. 오늘은 제가 인정해 드릴게요.",
      "inner": "(무리한 건 아니겠지? 기쁘면서도 걱정되잖아.)"
    },
    {
      "id": "timer-end-long-02",
      "key": "timer.end.long",
      "char": "kaguya",
      "face": "neutral",
      "text": "{duration}이라니… 이제는 반드시 쉬세요.",
      "inner": "(열심히 한 건 멋지지만 몸이 상하면 아무 소용 없으니까.)"
    }
  ]
}
